{
  "name": "pswmanager",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:web": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "build": "tauri build --no-bundle",
    "build:x64": "npm run build -- --target x86_64-pc-windows-msvc",
    "build:arm64": "npm run build -- --target aarch64-pc-windows-msvc",
    "build:android-web": "tsc --noEmit -p apps/android/ui && vite build --config apps/android/ui/vite.config.ts",
    "test": "vitest run && cargo test"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3"
  }
}

{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PswManager",
  "identifier": "io.github.olegg90.pswmanager",
  "build": {
    "frontendDist": "../../dist-android",
    "beforeBuildCommand": "npm run build:android-web"
  },
  "app": {
    "windows": [
      {
        "title": "PswManager"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/128x128@2x.png",
      "../../src-tauri/icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "io.github.olegg90.pswmanager"
          ],
          "appLink": false
        }
      ]
    }
  }
}

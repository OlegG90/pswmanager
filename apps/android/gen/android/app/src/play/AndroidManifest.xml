<?xml version="1.0" encoding="utf-8"?>
<!-- Merged over the main manifest in the Google Play build (#394,
     PSWM_PLAY_BUILD in build.gradle.kts): Play keeps All files access from a
     password manager, so the app offers Android's pickers only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:node="remove" />
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- All files access: offered when something is to be chosen on the
         phone, as Android's pickers hide some folders (one named Data, say);
         never granted without the user turning it on. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.pswm_android"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PswManager as a credential provider (Android 14+, stage A5). -->
        <service
            android:name=".PswmCredentialService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider" />
        </service>
        <activity
            android:name=".PasswordActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.pswm_android.Translucent" />
        <activity
            android:name=".CreatePasswordActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:excludeFromRecents="true" />
        <activity
            android:name=".CreatePasskeyActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:excludeFromRecents="true" />
        <activity
            android:name=".PasskeyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.pswm_android.Translucent" />
        <!-- Another password manager imports from PswManager (#153): Android's
             Credential Transfer starts it, only with write access to the URI
             the export goes to. -->
        <activity
            android:name=".ExportActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:requireContentUriPermissionFromCaller="write"
            android:screenOrientation="portrait">
            <!-- The URI is the importer's file provider's: Android resolves its
                 type, and a filter without one would not match then (two
                 filters, as data in one would make the type required). -->
            <intent-filter>
                <action android:name="androidx.identitycredentials.action.IMPORT_CREDENTIALS" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.identitycredentials.action.IMPORT_CREDENTIALS" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <activity
            android:name=".UnlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait" />
        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
